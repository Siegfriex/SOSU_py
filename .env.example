GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

GEMINI_MODEL_OBSERVE=gemini-3.8-flash
GEMINI_MODEL_DIAGNOSIS=gemini-3.8-flash
GEMINI_MODEL_PRESCRIPTION=gemini-3.8-flash

GEMINI_THINKING_OBSERVE=low
GEMINI_THINKING_SYNTHESIS=medium
GEMINI_THINKING_REPAIR=low

GEMINI_MAX_OUTPUT_OBSERVE=2048
GEMINI_MAX_OUTPUT_DIAGNOSIS=8192
GEMINI_MAX_OUTPUT_PRESCRIPTION=4096
GEMINI_MAX_OUTPUT_REPAIR=4096

GEMINI_TIMEOUT_OBSERVE=45
GEMINI_TIMEOUT_SYNTHESIS=90
GEMINI_TIMEOUT_REPAIR=40
SOSU_REQUEST_DEADLINE_SECONDS=180

SOSU_ENV=development
SOSU_LOG_LEVEL=INFO
SOSU_CORS_ORIGINS=http://localhost:5173
SOSU_API_HOST=127.0.0.1
SOSU_API_PORT=8000

RUN_LIVE_GEMINI_TESTS=0

# guidebook knowledge pack — leave unset to use SOSU_py/knowledge/guidebook/knowledgepack.v1.json (resolved from the app package)
# SOSU_KNOWLEDGE_PATH=/absolute/path/to/knowledgepack.v1.json
# external research for prescription (Phase 2; no live search implemented yet)
SOSU_RESEARCH_ENABLED=false
