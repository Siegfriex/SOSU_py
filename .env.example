GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

GEMINI_MODEL_OBSERVE=gemini-3.8-flash
GEMINI_MODEL_DIAGNOSIS=gemini-3.8-flash
GEMINI_MODEL_PRESCRIPTION=gemini-3.8-flash

GEMINI_THINKING_OBSERVE=low
GEMINI_THINKING_SYNTHESIS=medium
GEMINI_THINKING_REPAIR=low

GEMINI_MAX_OUTPUT_OBSERVE=2048
GEMINI_MAX_OUTPUT_DIAGNOSIS=8192
GEMINI_MAX_OUTPUT_PRESCRIPTION=4096
GEMINI_MAX_OUTPUT_REPAIR=4096

GEMINI_TIMEOUT_OBSERVE=45
GEMINI_TIMEOUT_SYNTHESIS=90
GEMINI_TIMEOUT_REPAIR=40
SOSU_REQUEST_DEADLINE_SECONDS=180

SOSU_ENV=development
SOSU_LOG_LEVEL=INFO
SOSU_CORS_ORIGINS=http://localhost:5173,https://sosu-rosy.vercel.app
SOSU_API_HOST=127.0.0.1
SOSU_API_PORT=8000

RUN_LIVE_GEMINI_TESTS=0

# guidebook knowledge pack — leave unset to use SOSU_py/knowledge/guidebook/knowledgepack.v1.json (resolved from the app package)
# SOSU_KNOWLEDGE_PATH=/absolute/path/to/knowledgepack.v1.json
# external research for prescription (Phase 2; no live search implemented yet)
SOSU_RESEARCH_ENABLED=false

# ---- Phase 2 security (docs/SECURITY.md) ----
# Public paid inference is FAIL-CLOSED on Vercel (VERCEL=1) or SOSU_ENV=production.
# Set true ONLY after a Vercel WAF rate-limit rule + spend limit are in place.
SOSU_PUBLIC_INFERENCE_ENABLED=false
# Per-instance backstop (NOT a shared limit), requests/min/IP on public runtime only.
SOSU_RATELIMIT_AI_PER_MINUTE=6
SOSU_RATELIMIT_EMAIL_PER_MINUTE=3
SOSU_MAX_REQUEST_BYTES=4000000

# ---- Report e-mail (docs/EMAIL.md) — all three required, else 503 ----
RESEND_API_KEY=
# must be on a Resend-verified domain, e.g. "SOSU <report@your-domain>"
SOSU_EMAIL_FROM=
# >= 32 random bytes, e.g. `openssl rand -hex 32`. Also enables delivery_token on reports.
SOSU_DELIVERY_SIGNING_SECRET=
SOSU_PUBLIC_EMAIL_ENABLED=false
SOSU_DELIVERY_TOKEN_MAX_AGE_SECONDS=86400

# ---- Image storage: NOT implemented (docs/IMAGE_STORAGE.md) ----
SOSU_IMAGE_RETENTION_DAYS=0
