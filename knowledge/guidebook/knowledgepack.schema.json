{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sosu-guidebook-knowledgepack.v1",
  "title": "SOSU Guidebook KnowledgePack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version", "source", "style", "rules", "task_mapping"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "pack_id": {"const": "sosu-guidebook"},
    "version": {"type": "string", "pattern": "^gb2-[0-9a-f]{8}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "sha256", "pages"],
      "properties": {
        "filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pages": {"type": "integer", "minimum": 1}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["voice", "do", "dont", "example_phrases"],
      "properties": {
        "voice": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "do": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "dont": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "example_phrases": {"type": "array", "items": {"type": "string", "maxLength": 15}}
      }
    },
    "rules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rule_id", "category", "source_pages", "source_section", "principle", "applicability",
                     "recommended_action", "exceptions_or_cautions", "evidence_type", "tags", "priority"],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^GB-[A-Z]+-[0-9]{3}$"},
          "category": {"$ref": "#/$defs/category"},
          "source_pages": {"type": "array", "minItems": 1, "uniqueItems": true,
                           "items": {"type": "integer", "minimum": 1, "maximum": 45}},
          "source_section": {"type": "string", "minLength": 1},
          "principle": {"type": "string", "minLength": 1, "maxLength": 200},
          "applicability": {"type": "array", "minItems": 1, "uniqueItems": true,
                            "items": {"enum": ["diagnosis", "prescription"]}},
          "recommended_action": {"type": "string", "minLength": 1, "maxLength": 200},
          "exceptions_or_cautions": {"type": ["string", "null"]},
          "evidence_type": {"enum": ["guidebook_principle", "guidebook_example", "author_experience"]},
          "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"}},
          "priority": {"enum": [1, 2, 3]}
        }
      }
    },
    "task_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["diagnosis", "prescription"],
      "properties": {
        "diagnosis": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/category"}}},
        "prescription": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/category"}}}
      }
    }
  },
  "$defs": {
    "category": {"enum": ["reels_fundamentals", "reel_types", "combination", "ideation", "storyboard", "equipment",
      "lighting", "composition", "camera_angle", "editing_pacing", "video_length", "music_sound", "hook", "caption",
      "cta", "performance_interpretation", "brand_strategy"]}
  }
}
